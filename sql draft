-- ============================================================
--  Ationg's Fruit Shake Inventory System - Supabase schema
-- ============================================================

-- ---------- TABLES ----------

create table public.inventory_items (
  id             uuid primary key default gen_random_uuid(),
  name           text not null check (length(trim(name)) > 0),
  category       text not null default 'Uncategorized',  -- Fruit, Milk, Ice, Cups...
  quantity       numeric(12,2) not null default 0 check (quantity >= 0),
  unit           text not null default 'pcs',            -- kg, pcs, L
  price          numeric(12,2) not null default 0 check (price >= 0),  -- cost per unit
  reorder_level  numeric(12,2) not null default 5 check (reorder_level >= 0),
  expiry_date    date,
  created_at     timestamptz not null default now(),
  updated_at     timestamptz not null default now()
);

-- no duplicate item names (case-insensitive: "Mango" = "mango")
create unique index inventory_items_name_unique
  on public.inventory_items (lower(name));

create table public.activity_logs (
  id          uuid primary key default gen_random_uuid(),
  item_id     uuid,        -- no foreign key on purpose, so logs survive item deletion
  item_name   text not null,
  action      text not null
              check (action in ('ADD','EDIT','DELETE','RESTOCK','USED','SPOILED')),
  amount      numeric(12,2) not null default 0,
  created_by  uuid default auth.uid(),
  created_at  timestamptz not null default now()
);

create index activity_logs_created_at_idx on public.activity_logs (created_at desc);

-- ---------- AUTO-UPDATE updated_at ----------

create or replace function public.set_updated_at()
returns trigger
language plpgsql
set search_path = ''
as $$
begin
  new.updated_at = now();
  return new;
end;
$$;

create trigger inventory_items_set_updated_at
  before update on public.inventory_items
  for each row execute function public.set_updated_at();

-- ---------- AUTO-LOG ADD / EDIT / DELETE ----------
-- (restock and use are logged by the functions further down)

create or replace function public.log_item_changes()
returns trigger
language plpgsql
set search_path = ''
as $$
begin
  if tg_op = 'INSERT' then
    insert into public.activity_logs (item_id, item_name, action, amount)
    values (new.id, new.name, 'ADD', new.quantity);

  elsif tg_op = 'DELETE' then
    insert into public.activity_logs (item_id, item_name, action, amount)
    values (old.id, old.name, 'DELETE', old.quantity);

  elsif tg_op = 'UPDATE' then
    -- only log EDIT when quantity did not change (quantity changes are RESTOCK/USED)
    if old.quantity = new.quantity then
      insert into public.activity_logs (item_id, item_name, action, amount)
      values (new.id, new.name, 'EDIT', 0);
    end if;
  end if;

  return null;
end;
$$;

create trigger inventory_items_log_changes
  after insert or update or delete on public.inventory_items
  for each row execute function public.log_item_changes();

-- ---------- STOCK FUNCTIONS (safe, atomic) ----------

-- Stock in: deliveries from suppliers
create or replace function public.restock_item(p_item_id uuid, p_amount numeric)
returns public.inventory_items
language plpgsql
set search_path = ''
as $$
declare
  v_item public.inventory_items;
begin
  if p_amount is null or p_amount <= 0 then
    raise exception 'Amount must be greater than 0';
  end if;

  update public.inventory_items
     set quantity = quantity + p_amount
   where id = p_item_id
   returning * into v_item;

  if not found then
    raise exception 'Item not found';
  end if;

  insert into public.activity_logs (item_id, item_name, action, amount)
  values (v_item.id, v_item.name, 'RESTOCK', p_amount);

  return v_item;
end;
$$;

-- Stock out: p_reason is 'USED' or 'SPOILED'
create or replace function public.use_stock(
  p_item_id uuid,
  p_amount  numeric,
  p_reason  text default 'USED'
)
returns public.inventory_items
language plpgsql
set search_path = ''
as $$
declare
  v_item public.inventory_items;
begin
  if p_amount is null or p_amount <= 0 then
    raise exception 'Amount must be greater than 0';
  end if;

  if p_reason not in ('USED', 'SPOILED') then
    raise exception 'Reason must be USED or SPOILED';
  end if;

  update public.inventory_items
     set quantity = quantity - p_amount
   where id = p_item_id
     and quantity >= p_amount
   returning * into v_item;

  if not found then
    if exists (select 1 from public.inventory_items where id = p_item_id) then
      raise exception 'Not enough stock';
    else
      raise exception 'Item not found';
    end if;
  end if;

  insert into public.activity_logs (item_id, item_name, action, amount)
  values (v_item.id, v_item.name, p_reason, p_amount);

  return v_item;
end;
$$;

-- only logged-in users may call these
revoke execute on function public.restock_item(uuid, numeric) from public, anon;
revoke execute on function public.use_stock(uuid, numeric, text) from public, anon;
grant  execute on function public.restock_item(uuid, numeric) to authenticated;
grant  execute on function public.use_stock(uuid, numeric, text) to authenticated;

-- ---------- REPORT VIEWS ----------

create view public.low_stock_items
with (security_invoker = true) as
  select * from public.inventory_items
  where quantity <= reorder_level
  order by name;

create view public.expiring_items
with (security_invoker = true) as
  select * from public.inventory_items
  where expiry_date is not null
    and expiry_date <= current_date + 3     -- includes already expired
  order by expiry_date;

create view public.inventory_summary
with (security_invoker = true) as
  select
    count(*)                                          as total_items,
    coalesce(sum(quantity * price), 0)                as total_value,
    count(*) filter (where quantity <= reorder_level) as low_stock_count,
    count(*) filter (where expiry_date is not null
                       and expiry_date <= current_date + 3) as expiring_count
  from public.inventory_items;

-- ---------- SECURITY (Row Level Security) ----------
-- Only logged-in (authenticated) users can touch the data.
-- Without these policies, anyone with your public key could read/edit everything.

alter table public.inventory_items enable row level security;
alter table public.activity_logs   enable row level security;

create policy "Staff can view items"
  on public.inventory_items for select to authenticated using (true);
create policy "Staff can add items"
  on public.inventory_items for insert to authenticated with check (true);
create policy "Staff can edit items"
  on public.inventory_items for update to authenticated using (true) with check (true);
create policy "Staff can delete items"
  on public.inventory_items for delete to authenticated using (true);

-- logs: read and add only (nobody can edit or delete history)
create policy "Staff can view logs"
  on public.activity_logs for select to authenticated using (true);
create policy "Staff can add logs"
  on public.activity_logs for insert to authenticated with check (true);

